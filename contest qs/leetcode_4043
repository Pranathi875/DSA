class Solution {
    public int countRotations(String s, int k) {
        int n=s.length();
        int cnt=0;
        for(int i=0;i<n;i++){
            String rot=s.substring(i)+s.substring(0,i);
            int score=0;
            for(int j=0;j<n-1;j++){
                if(rot.charAt(j)==rot.charAt(j+1)){
                    score++;
                }
            }
            if(score==k){
                cnt++;
            }
        }
        return cnt;
    }
}
