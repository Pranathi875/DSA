class Solution {
    public int countRatioSubarrays(int[] nums, int a, int b) {
        int count=0;
        for(int i=0;i<nums.length;i++){
            int x=0,y=0;
            for(int j=i;j<nums.length;j++){
                if(nums[j]%2==0){
                    x++;
                }
                else{
                    y++;
                }
                 if(y>0){
                  double ratio=(double)x/y;
                     if(ratio<=(double)a/b){
                       count++;  
                      }
                  }
            }
           
        }
        return count;
    }
}
