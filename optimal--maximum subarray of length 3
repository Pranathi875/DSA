import java.util.*;
class Main {
    public static void main(String[] args) {
       int maxSum=Integer.MIN_VALUE;
       int sum=0;
       
       int arr[]={1,5,7,9,8};
       int left=0;
       for(int r=0;r<arr.length;r++){
           sum=sum+arr[r];
           
           if(r-left+1==3){
               maxSum=Math.max(maxSum,sum);
               sum=sum-arr[left];
               left++;
           }
       }
       System.out.println(maxSum);
     
    }
}
