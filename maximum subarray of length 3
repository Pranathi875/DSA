
import java.util.*;
class Main {
    public static void main(String[] args) {
        
        int arr[]={5,9,1,8,7};
      
        int maxSum=0;
        for(int i=0;i<arr.length-2;i++){
            int j=i+2;
            int sum=arr[i]+arr[i+1]+arr[j];
            maxSum=Math.max(maxSum,sum);
        }
        System.out.println(maxSum);
        
            
    }
}
