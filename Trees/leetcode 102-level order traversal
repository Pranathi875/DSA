class Solution {
    public List<List<Integer>> levelOrder(TreeNode root) {
        
        List<List<Integer>>ans=new ArrayList<>();
        if(root==null){
            return ans;
        }
        Queue<TreeNode>q=new LinkedList<>();
        q.offer(root);
        while(!q.isEmpty()){
            List<Integer>ls=new ArrayList<>();
            int size=q.size();
            for(int i=0;i<size;i++){
                root=q.poll();
                ls.add(root.val);
                if(root.left!=null){
                    q.offer(root.left);
                }
                if(root.right!=null){
                    q.offer(root.right);
                }

            }
          ans.add(ls);
        }
       return ans;
    }
}
