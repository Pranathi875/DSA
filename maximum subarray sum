
import java.util.*;
class Main {
    public static void main(String[] args) {
        //System.out.println("Try programiz.pro");
        int arr[]={5,9,1,8,7};
        //Arrays.sort(arr);
        int maxSum=0;
        for(int i=0;i<arr.length;i++){
            for(int j=i;j<arr.length;j++){
                int sum=0;
                for(int k=i;k<=j;k++){
                    sum=sum+arr[k];
                }
                maxSum=Math.max(sum,maxSum);
            }
        }
        System.out.println(maxSum);
        
            
    }
}
