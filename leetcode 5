class Solution {
    public String longestPalindrome(String s) {
        String maxPal="";
        if(s.length()<0){
            return "";
        }
        for(int i=0;i<s.length();i++){
            int low=i;
            int high=i;
            while(low>=0&&high<s.length()&&s.charAt(low)==s.charAt(high)){
                low--;
                high++;
            }
            
            String pal=s.substring(low+1,high);
            if(pal.length()>maxPal.length()){
                maxPal=pal;
            }
            
        }
        for(int i=0;i<s.length();i++){
            int low=i-1;
            int high=i;
            while(low>=0&&high<s.length()&&s.charAt(low)==s.charAt(high)){
                low--;
                high++;
            }
            
            String pal=s.substring(low+1,high);
            if(pal.length()>maxPal.length()){
                maxPal=pal;
            }
        }




   return maxPal;

    }
}
