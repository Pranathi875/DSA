class Solution {
    public int findNumbers(int[] nums) {
        int cnt=0;
       for(int i=0;i<nums.length;i++){
          int res=func(nums[i]);
          if(res%2==0){
            cnt++;
          }
       }
       return cnt;
    }
    public int func(int n){
        if(n==0){
            return 0;
        }
        return 1+func(n/10);
    }
}
