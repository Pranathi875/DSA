class Main {
    public static void main(String[] args) {
        int arr[]={0,1,0,3,12};
        int temp[]=new int[5];
        int count=0;
        for(int i=0;i<5;i++){
            if(arr[i]==0){
                count++;
            }
        }
        for(int i=arr.length-1;i>=arr.length-count;i--){
            temp[i]=0;
        }
        int j=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]!=0){
                temp[j]=arr[i];
                j++;
            }
        }
        for(int i=0;i<arr.length;i++){
            System.out.println(temp[i]);
        }
    }
}
