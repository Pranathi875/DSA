
import java.util.*;
public class Main
{
     public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        
        int arr[]={1,2,1};
        int k=2;
        printSubSeq(0,arr,new ArrayList<>(),0,k);
       
    }
    public static void printSubSeq(int idx,int arr[],List<Integer>ls,int sum,int target){
         if(idx==arr.length){
             if(sum==target)
             System.out.println(ls);
            return;
         }
         ls.add(arr[idx]);
         printSubSeq(idx+1,arr,ls,sum+arr[idx],target);
         ls.remove(ls.size()-1);
         printSubSeq(idx+1,arr,ls,sum,target);
        
    }
	
}
