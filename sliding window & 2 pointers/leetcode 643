class Solution {
    public double findMaxAverage(int[] nums, int k) {
        double sum=0;
        int l=0;
        double max= Double.NEGATIVE_INFINITY;
        for(int r=0;r<nums.length;r++){
            sum+=(double)nums[r];
            if(r-l+1==k){
                double avg=sum/k;
                max=(double)Math.max(max,avg);
                sum-=nums[l];
                l++;
            }
        }
        return max;
    }
}
