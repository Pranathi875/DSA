class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int l=0;
        double sum=0;
        double count=0;
        double max = Double.NEGATIVE_INFINITY;
        for(int r=0;r<nums.length;r++){
            sum+=(double)nums[r];
            count++;
           
            if(r-l+1==k){
                double avg = sum / k;
                max = Math.max(max, avg);
                sum -= nums[l];
                l++;
               
            }
           
        }
        return max;
    }
}
