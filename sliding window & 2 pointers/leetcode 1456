class Solution {
    public int maxVowels(String s, int k) {
      int l=0;
      int count=0;
      int max=0;
      for(int r=0;r<s.length();r++){
        char ch=s.charAt(r);
        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'){
            count++;
        }
        if(r-l+1==k){
            max=Math.max(max,count);
            if(s.charAt(l)=='a'||s.charAt(l)=='e'||s.charAt(l)=='i'||s.charAt(l)=='o'||s.charAt(l)=='u'){
                count--;
            }
           
            l++;
        }
      }
      return max;
    }
}
